APP_ENV=production
APP_DEBUG=false
APP_URL=https://localjoin.in
SECRET_KEY=replace-with-a-32-byte-secret-key-material
DATABASE_URL=mysql+pymysql://user:password@host:3306/localconnect_db
UPLOAD_STORAGE_BACKEND=filesystem
UPLOAD_STORAGE_ROOT=/var/data/localconnect/uploads
UPLOAD_DISK_REQUIRED=true
TRUSTED_HOSTS=example.onrender.com
MAX_REQUEST_BYTES=8388608
SLOW_REQUEST_MS=1500

# Administrator Accounts (Configurable via Environment Variables)
# Option 1: Separate variables for up to multiple admins
ADMIN_1_EMAIL=admin1@localjoin.in
ADMIN_1_PASSWORD=ChangeThisAdminPassword123!
ADMIN_1_NAME=Super Admin

ADMIN_2_EMAIL=admin2@localjoin.in
ADMIN_2_PASSWORD=ChangeThisAdminPassword456!
ADMIN_2_NAME=Operations Admin

ADMIN_3_EMAIL=admin3@localjoin.in
ADMIN_3_PASSWORD=ChangeThisAdminPassword789!
ADMIN_3_NAME=Support Admin

# Option 2: Single combined variable
# ADMIN_USERS=admin1:pass123:Admin One,admin2:pass456:Admin Two,admin3:pass789:Admin Three
